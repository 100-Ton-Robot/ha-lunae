          "entities": [
            {
              "entity": "sensor.lunae_cairo_bus_stop_azimuth",
              "name": "Azimuth"
            },
            {
              "entity": "sensor.lunae_cairo_bus_stop_elevation",
              "name": "Elevation"
            }
          ]
        }
      ]
    },
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Cairo Bus Stop — phase and size",
          "icon": "mdi:moon-waxing-crescent"
        },
        {
          "type": "tile",
