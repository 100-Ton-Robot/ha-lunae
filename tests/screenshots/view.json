{
  "title": "Lunae README",
  "path": "lunae-readme",
  "type": "sections",
  "max_columns": 3,
  "sections": [
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Cairo Bus Stop — position",
          "icon": "mdi:compass-outline"
        },
        {
          "type": "tile",
          "entity": "sensor.lunae_cairo_bus_stop_azimuth",
          "grid_options": {
            "columns": 6
          },
          "name": "Azimuth"
        },
        {
          "type": "tile",
          "entity": "sensor.lunae_cairo_bus_stop_elevation",
          "grid_options": {
            "columns": 6
          },
          "name": "Elevation"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.lunae_cairo_bus_stop_above_horizon",
          "grid_options": {
            "columns": 12
          },
          "name": "Above horizon"
        },
        {
          "type": "entities",
          "title": "Rise / set",
          "entities": [
            {
              "entity": "sensor.lunae_cairo_bus_stop_next_moonrise",
              "name": "Moonrise",
              "format": "datetime"
            },
            {
              "entity": "sensor.lunae_cairo_bus_stop_next_moonset",
              "name": "Moonset",
              "format": "datetime"
            }
          ]
        },
        {
          "type": "history-graph",
